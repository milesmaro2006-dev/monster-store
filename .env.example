# Copy this file to .env and fill in local values.
# Never commit a real .env file.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# SQLite is the default local database.
# DATABASE_URL=sqlite:///instance/monster.db
# On hosts with a persistent disk, point SQLite at its mounted absolute path.
# SQLITE_DATABASE_PATH=/var/data/monster.db

# Set to true only behind HTTPS in production.
SESSION_COOKIE_SECURE=False

# Optional public site URL used for canonical links after a real deployment.
# PUBLIC_BASE_URL=https://example.com

# Maximum quantity of a single product in the cart.
MAX_CART_QTY=20

# Enable only after confirming cash on delivery is supported by the owner.
COD_ENABLED=false

# Admin URL prefix (change this path; authorization is enforced separately).
ADMIN_URL_PREFIX=/portal-spidey
STORE_TIMEZONE=Africa/Cairo

# Production must use a shared rate-limit store, such as Redis.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
